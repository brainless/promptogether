# Cloudflare Pages redirect/rewrite rules. Evaluated top to bottom; static
# files that exist on disk are always served over these rules, so this only
# affects paths with no matching file.
#
# Permanent redirects from the old underscore-cased post slugs to their new
# lowercase-with-dashes slugs (scripts/posts.mjs now slugifies filenames).
# Keep these until search engines and any external links have caught up.
/posts/Becoming_Agent_Enabled_Software_Builder            /posts/becoming-agent-enabled-software-builder            301
/posts/Becoming_Agent_Enabled_Software_Builder_Part_II    /posts/becoming-agent-enabled-software-builder-part-ii    301
/posts/In_Support_of_Agent_Led_Software_Engineering       /posts/in-support-of-agent-led-software-engineering       301
/posts/Introduction                                       /posts/introduction                                       301
/posts/Why_Manage_Project_Context_Via_Epics               /posts/why-manage-project-context-via-epics               301

# Prerendered post pages live at dist/posts/<slug>/index.html (generated by
# scripts/prerender-posts.mjs) — these explicit rewrites make sure a
# request for the clean URL (no trailing slash) resolves to that file
# rather than falling through to the SPA shell below.
/posts/:slug   /posts/:slug/index.html   200
/posts         /posts/index.html         200
/concepts      /concepts/index.html      200

# Client-side routing fallback for the rest of the app (homepage, gallery).
/*             /index.html               200
